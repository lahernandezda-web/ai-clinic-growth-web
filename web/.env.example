# Plantilla de variables de entorno para PLEXAI (web/). Sin secretos reales.
#
# - Nunca commitear web/.env.local.
# - Nunca pegar claves reales en chats.
# - En producción, configurar valores en el panel del hosting (p. ej. Vercel).
# - Esta plantilla no contiene secretos.

# Proveedor de IA en servidor. Por defecto usar "stub" hasta integrar Claude de forma controlada.
AI_PROVIDER=stub

# Solo servidor. Si se usa funcionalidad de IA (p. ej. AI_PROVIDER=claude).
ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-haiku-4-5

# Pública, cliente (Next.js expone NEXT_PUBLIC_* al navegador).
NEXT_PUBLIC_SUPABASE_URL=

# Pública, cliente. Revisar RLS y permisos en Supabase.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Nunca exponer al navegador ni usar en código cliente.
SUPABASE_SERVICE_ROLE_KEY=

# true/false. Activar automatizaciones solo cuando n8n esté listo y configurado.
AUTOMATIONS_ENABLED=false

# Solo servidor. URL del webhook de n8n (no documentar valor real en el repo).
N8N_WEBHOOK_URL=

# Solo servidor. Compartido con n8n para validar el header X-Automation-Secret.
N8N_WEBHOOK_SECRET=
